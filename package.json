{
  "name": "personal-radar",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3210",
    "repo:check": "node scripts/check-public-repo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:test": "vitest run tests/database.test.ts"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "^0.31.7",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
